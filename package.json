{
  "name": "torrent2synology",
  "version": "0.1.0",
  "description": "Send torrent files and magnet links to Synology Download Station",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "vendor": "mkdir -p src/vendor && sed '/sourceMappingURL/d' node_modules/bootstrap/dist/css/bootstrap.min.css > src/vendor/bootstrap.min.css",
    "test": "node scripts/test-crypto.mjs",
    "check:secrets": "node scripts/check-secrets.mjs staged",
    "lint": "web-ext lint --source-dir src",
    "run:firefox": "web-ext run --source-dir src",
    "run:chrome": "web-ext run --source-dir src --target chromium",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "bootstrap": "5.3",
    "web-ext": "^8.0.0"
  }
}
